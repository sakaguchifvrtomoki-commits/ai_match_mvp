{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3b-agent-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "agent_id", "planned_action", "started", "start_utc", "completed", "end_utc", "exit_code", "timed_out", "collected", "validation_stage", "success", "reason_code", "error_summary", "preflight", "postflight"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "enum": ["backend", "flutter", "test_review"] },
    "planned_action": { "enum": ["RUN", "SKIP"] },
    "started": { "type": "boolean" },
    "start_utc": { "type": ["string", "null"], "format": "date-time" },
    "completed": { "type": "boolean" },
    "end_utc": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "collected": { "type": "boolean" },
    "validation_stage": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "reason_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "error_summary": { "type": "string" },
    "report_path": { "type": "string", "minLength": 1 },
    "preflight": { "type": ["object", "null"] },
    "postflight": { "type": ["object", "null"] }
  }
}
