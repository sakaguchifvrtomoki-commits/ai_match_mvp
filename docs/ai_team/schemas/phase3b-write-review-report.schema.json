{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3b-write-review-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "reviewer_agent_id", "review_type", "reviewed_agent_ids", "reviewed_artifact_sha256", "reviewed_schema_sha256", "acceptance_criteria_results", "findings", "unverified_items", "review_verdict", "final_result"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "reviewer_agent_id": { "const": "test_review" },
    "review_type": { "const": "WRITE_RUNTIME" },
    "reviewed_agent_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["backend", "flutter"] } },
    "reviewed_artifact_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "reviewed_schema_sha256": { "type": "object", "minProperties": 6, "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "acceptance_criteria_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ac" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "unverified_items": { "type": "array", "items": { "type": "string" } },
    "review_verdict": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
    "final_result": { "enum": ["READY_FOR_PHASE3C", "BLOCKED"] }
  },
  "allOf": [
    {
      "if": { "properties": { "findings": { "contains": { "properties": { "severity": { "enum": ["BLOCKER", "MAJOR"] } }, "required": ["severity"] } } } },
      "then": { "properties": { "review_verdict": { "const": "REQUEST_CHANGES" }, "final_result": { "const": "BLOCKED" } } }
    },
    {
      "if": { "properties": { "review_verdict": { "const": "REQUEST_CHANGES" } }, "required": ["review_verdict"] },
      "then": { "properties": { "final_result": { "const": "BLOCKED" } } }
    },
    {
      "if": { "properties": { "final_result": { "const": "READY_FOR_PHASE3C" } }, "required": ["final_result"] },
      "then": { "properties": { "review_verdict": { "const": "APPROVE" }, "findings": { "not": { "contains": { "properties": { "severity": { "enum": ["BLOCKER", "MAJOR"] } }, "required": ["severity"] } } } } }
    }
  ],
  "$defs": {
    "ac": { "type": "object", "additionalProperties": false, "required": ["criterion", "result"], "properties": { "criterion": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] }, "notes": { "type": "string" } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["severity", "location", "reproduction_condition", "expected_result"], "properties": { "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR"] }, "location": { "type": "string", "minLength": 1 }, "reproduction_condition": { "type": "string", "minLength": 1 }, "expected_result": { "type": "string", "minLength": 1 }, "acceptance_reason": { "type": "string", "minLength": 1 }, "impact_assessment": { "type": "string", "minLength": 1 }, "follow_up": { "type": "string", "minLength": 1 } } }
  }
}
