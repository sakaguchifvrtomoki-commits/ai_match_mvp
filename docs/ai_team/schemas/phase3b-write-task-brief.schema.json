{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3b-write-task-brief.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "baseline_sha", "execution_strategy", "sequential_order", "agents"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "baseline_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "execution_strategy": { "enum": ["PARALLEL", "SEQUENTIAL"] },
    "sequential_order": { "type": "array", "uniqueItems": true, "items": { "enum": ["backend", "flutter"] } },
    "agents": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/agent" } }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\/])(?!.*[:*?\"<>|])(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$))(?!.*[\\/]$).+$" },
    "command": { "type": "object", "additionalProperties": false, "required": ["command_id", "executable", "argv", "working_directory", "timeout_seconds", "network", "external_service", "device"], "properties": { "command_id": { "type": "string", "minLength": 1 }, "executable": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "items": { "type": "string" } }, "working_directory": { "type": "string", "pattern": "^[A-Za-z]:" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "network": { "const": false }, "external_service": { "const": false }, "device": { "const": false } } },
    "agent": { "type": "object", "additionalProperties": false, "required": ["agent_id", "disposition", "worktree_absolute_path", "git_top_level", "branch", "expected_head", "run_mode", "allowed_files", "forbidden_files", "instructions", "test_commands", "dependencies"], "properties": {
      "agent_id": { "enum": ["backend", "flutter", "test_review"] },
      "disposition": { "enum": ["RUN", "SKIP"] },
      "worktree_absolute_path": { "type": "string", "pattern": "^[A-Za-z]:" },
      "git_top_level": { "type": "string", "pattern": "^[A-Za-z]:" },
      "branch": { "type": "string", "minLength": 1 },
      "expected_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "run_mode": { "enum": ["WRITE", "READ_ONLY"] },
      "allowed_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
      "forbidden_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
      "instructions": { "type": "string" },
      "test_commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
      "dependencies": { "type": "array", "uniqueItems": true, "items": { "enum": ["backend", "flutter"] } }
    } }
  }
}
