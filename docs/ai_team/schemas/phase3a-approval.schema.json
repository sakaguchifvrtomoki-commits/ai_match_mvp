{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3a-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "verdict", "task_brief_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "verdict": { "const": "APPROVE" },
    "task_brief_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
